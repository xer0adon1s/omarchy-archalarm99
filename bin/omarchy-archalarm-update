#!/bin/bash
# omarchy-archalarm-update: checks GitHub for a newer tagged release and,
# on request, stages it in a git worktree. Symlink activation (install.sh)
# is deferred to `activate`, which runs on shell reload — so repointing
# the live plugin path never hot-reloads the bar mid-update animation.
set -euo pipefail

# Resolve through the ~/.local/bin symlink install.sh creates — this script
# is never run from its real path, so BASH_SOURCE alone would resolve
# relative to the symlink's directory instead of the repo.
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STATE_DIR="$HOME/.local/state/omarchy/archalarm"
UPDATE_FILE="$STATE_DIR/update.json"
PENDING_FILE="$STATE_DIR/pending-activate.json"
BOOT_ID_FILE="$STATE_DIR/last-boot-id"
CHECK_INTERVAL_SEC=86400

mkdir -p "$STATE_DIR"

current_version() {
  python3 -c "import json; print(json.load(open('$REPO_DIR/plugin/manifest.json'))['version'])" 2>/dev/null || echo "unknown"
}

latest_tag() {
  git -C "$REPO_DIR" tag -l 'v*' | sed 's/^v//' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1
}

version_gt() {
  # $1 > $2, as dotted-integer versions
  python3 -c "
def v(s): return tuple(int(x) for x in s.split('.'))
import sys
sys.exit(0 if v('$1') > v('$2') else 1)
" 2>/dev/null
}

write_update_json() {
  local checking="$1" available="$2" latest="$3" err="$4"
  local pending_activate="${5:-false}"
  local pending_version="${6:-}"
  local current_explicit="${7:-}"
  local current="${current_explicit:-$(current_version)}"
  python3 - "$checking" "$available" "$latest" "$err" "$pending_activate" "$pending_version" "$UPDATE_FILE" "$current" <<'PYEOF'
import json, os, sys, time
checking, available, latest, err, pending_activate, pending_version, path, current = sys.argv[1:9]
data = {
    "checking": checking == "true",
    "updateAvailable": available == "true",
    "pendingActivate": pending_activate == "true",
    "pendingVersion": pending_version,
    "currentVersion": current,
    "latestVersion": latest,
    "lastCheckAt": time.time(),
    "error": err,
}
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(data, f)
os.replace(tmp, path)
PYEOF
}

write_pending_activate() {
  local staged_dir="$1" staged_version="$2"
  python3 - "$staged_dir" "$staged_version" "$PENDING_FILE" <<'PYEOF'
import json, os, sys, time
path, version, out = sys.argv[1], sys.argv[2], sys.argv[3]
data = {"path": path, "version": version, "stagedAt": time.time()}
tmp = out + ".tmp"
with open(tmp, "w") as f:
    json.dump(data, f)
os.replace(tmp, out)
PYEOF
}

read_pending_path() {
  [[ -f "$PENDING_FILE" ]] || return 1
  python3 -c "import json; print(json.load(open('$PENDING_FILE'))['path'])" 2>/dev/null
}

read_pending_version() {
  [[ -f "$PENDING_FILE" ]] || return 1
  python3 -c "import json; print(json.load(open('$PENDING_FILE'))['version'])" 2>/dev/null
}

# Reads the last-known-good state without touching it — used so a "check"
# call that's skipped (too soon since the last one) still leaves the panel
# something sensible to display instead of going blank.
last_check_epoch() {
  [[ -f "$UPDATE_FILE" ]] || { echo 0; return; }
  python3 -c "import json; print(int(json.load(open('$UPDATE_FILE')).get('lastCheckAt', 0)))" 2>/dev/null || echo 0
}

cmd_check() {
  local force="${1:-}"
  local boot_id last_boot now pending_ver
  boot_id="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)"
  last_boot="$(cat "$BOOT_ID_FILE" 2>/dev/null || echo "")"
  now="$(date +%s)"

  if [[ "$force" != "force" && "$boot_id" == "$last_boot" && $(( now - $(last_check_epoch) )) -lt $CHECK_INTERVAL_SEC ]]; then
    [[ -f "$UPDATE_FILE" ]] && cat "$UPDATE_FILE"
    return 0
  fi
  echo "$boot_id" > "$BOOT_ID_FILE"

  if ! git -C "$REPO_DIR" fetch --tags --quiet origin 2>/dev/null; then
    pending_ver="$(read_pending_version 2>/dev/null || true)"
    write_update_json false false "$(current_version)" "couldn't reach GitHub" \
      "$([[ -n "$pending_ver" ]] && echo true || echo false)" "${pending_ver:-}"
    cat "$UPDATE_FILE"
    return 1
  fi

  local latest current
  latest="$(latest_tag)"
  current="$(current_version)"
  pending_ver="$(read_pending_version 2>/dev/null || true)"

  if [[ -n "$pending_ver" ]]; then
    write_update_json false false "${pending_ver}" "" true "$pending_ver"
  elif [[ -n "$latest" && "$latest" != "$current" ]] && version_gt "$latest" "$current"; then
    write_update_json false true "$latest" "" false ""
  else
    write_update_json false false "${latest:-$current}" "" false ""
  fi
  cat "$UPDATE_FILE"
}

compute_new_dir() {
  local latest="$1"
  local base_name
  base_name="$(basename "$REPO_DIR" | sed -E 's/-v[0-9]+\.[0-9]+\.[0-9]+$//')"
  printf '%s/%s-v%s' "$(dirname "$REPO_DIR")" "$base_name" "$latest"
}

cmd_install() {
  if [[ -n "$(git -C "$REPO_DIR" status --porcelain 2>/dev/null)" ]]; then
    echo "ERROR: repo has local changes — commit or stash them before updating" >&2
    exit 1
  fi

  echo "STEP:FETCH"
  timeout 30 git -C "$REPO_DIR" fetch --tags --quiet origin

  local latest current pending_ver new_dir old_dir
  latest="$(latest_tag)"
  current="$(current_version)"
  [[ -n "$latest" ]] || { echo "ERROR: no release tags found" >&2; exit 1; }

  pending_ver="$(read_pending_version 2>/dev/null || true)"
  if [[ -n "$pending_ver" && "$pending_ver" == "$latest" ]]; then
    write_update_json false false "$latest" "" true "$latest"
    echo "STEP:DONE"
    return 0
  fi

  if [[ "$latest" == "$current" && -z "$pending_ver" ]]; then
    write_update_json false false "$latest" "" false ""
    echo "STEP:DONE"
    return 0
  fi

  old_dir="$REPO_DIR"
  new_dir="$(compute_new_dir "$latest")"

  if [[ "$new_dir" == "$old_dir" ]]; then
    echo "ERROR: refusing to rebuild the live worktree in place ($new_dir)" >&2
    exit 1
  fi

  echo "STEP:CHECKOUT"
  timeout 10 git -C "$REPO_DIR" worktree prune 2>/dev/null || true
  rm -rf "$new_dir"
  timeout 30 git -C "$REPO_DIR" worktree add --quiet "$new_dir" "v$latest"

  # Stage only — install.sh repoints archalarm-current (and triggers Omarchy
  # plugin hot-reload) only from `activate`, run on shell reload.
  echo "STEP:STAGE"
  write_pending_activate "$new_dir" "$latest"
  write_update_json false false "$latest" "" true "$latest"
  echo "STEP:DONE"
}

cmd_activate() {
  local staged_dir staged_version
  if [[ ! -f "$PENDING_FILE" ]]; then
    return 0
  fi

  staged_dir="$(read_pending_path)" || {
    rm -f "$PENDING_FILE"
    echo "ERROR: invalid pending-activate.json" >&2
    exit 1
  }
  staged_version="$(read_pending_version)" || staged_version=""

  if [[ ! -d "$staged_dir" || ! -f "$staged_dir/install.sh" ]]; then
    rm -f "$PENDING_FILE"
    echo "ERROR: staged update path missing: $staged_dir" >&2
    exit 1
  fi

  timeout 15 "$staged_dir/install.sh" >/dev/null
  timeout 10 systemctl --user daemon-reload
  if systemctl --user is-active --quiet omarchy-archalarm-monitor.service; then
    timeout 10 systemctl --user restart omarchy-archalarm-monitor.service
  fi

  rm -f "$PENDING_FILE"
  write_update_json false false "${staged_version:-$(current_version)}" "" false "" "${staged_version}"
}

case "${1:-check}" in
  check) cmd_check "${2:-}" ;;
  install) cmd_install ;;
  activate) cmd_activate ;;
  *)
    echo "usage: omarchy-archalarm-update <check [force]|install|activate>" >&2
    exit 1
    ;;
esac
